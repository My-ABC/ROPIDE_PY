{"input":"// FD24 E0 E9 8E 23 42 (calc = )\n\n$length = 400;\n\n<main> <-main-s>\n0000 [$main-s + 0] [$main + 0] [$main + 8] [$length] 0000 0000 0000 \n#memcpy+jmp-x4q8;\n{\n#rt-fix;\n#dis_int;\n#screen-on;\n\n#pop-xr0; F5D0 01 00 // 关闭自动关机，关光标，关太阳能板标志\n#byte-set;\n\n  #clear-ddd4;\n\n  #pop-er0; 00 01\n  #pop-er2; [$text1]\n  #print-text;\n\n  #pop-er0; 00 21\n  #pop-er2; [$text2]\n  #print-text;\n\n  #refresh-ddd4;\n\n  <loop> <-loop-s>\n  #pop-er0; [$key]\n  #get-key;\n\n  #pop-xr12; [$key-table - A] [$key-table - A]\n  #rt-fix;\n  407B0100 // ea=er12 + A\n\n  #pop-er0; <key>0000  // 最后会被替换成#get-key;获取的键码\n  #look-table; // 08f10 查表\n  #get-[ea]; // [ea]→er6,qr8\n  #jump6-e8;\n} \n\n<else>{\n  #pop-er0; [$length]\n  #pop-qr8;\n  0000 [$loop-s] [$loop] [$loop - 6]\n  #memcpy+jmp-x4q8;\n}\n\n<-text1> 41 64 64 72 3A 20 <addr-show>00000000 00 00 00 00 00 00 00\n\n<-text2> 56 61 6C 75 65 3A 20 <value-show>0000 00 00 00 00 00 00 00 00\n\n<key-table>\n0000: [$else - 2] 30 30 // else:","leftStartAddress":"E9E0","rightStartAddress":"D9D0","gadgets":[{"name":"pop-er0","addr":"121A8","desc":"赋值 ER0","tags":[]},{"name":"pop-er2","addr":"18814","desc":"赋值 ER2","tags":[]},{"name":"pop-er4","addr":"1827C","desc":"赋值 ER4","tags":[]},{"name":"pop-er6","addr":"139EE","desc":"赋值 ER6","tags":[]},{"name":"pop-er8","addr":"0C0F0","desc":"赋值 ER8","tags":[]},{"name":"pop-er10","addr":"0C29C","desc":"赋值 ER10","tags":[]},{"name":"pop-er12","addr":"21532","desc":"赋值 ER12","tags":[]},{"name":"pop-er14","addr":"20D72","desc":"赋值 ER14","tags":[]},{"name":"pop-xr0","addr":"16134","desc":"赋值 XR0","tags":[]},{"name":"pop-xr4","addr":"16D78","desc":"赋值 XR4","tags":[]},{"name":"pop-xr8","addr":"13846","desc":"赋值 XR8","tags":[]},{"name":"pop-xr12","addr":"1D52C","desc":"赋值 XR12","tags":[]},{"name":"pop-qr0","addr":"130E2","desc":"赋值 QR0","tags":[]},{"name":"pop-qr8","addr":"13236","desc":"赋值 QR8","tags":[]},{"name":"pop-all","addr":"22390","desc":"赋值 QR8, QR0","tags":[]},{"name":"rt-fix","addr":"2B